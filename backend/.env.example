MONGO_URI=mongodb://127.0.0.1:27017/crypto_income_platform
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000

# Required by `npm run seed` — becomes your real, live admin login.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=choose_a_strong_password_here

# Set to "true" to restrict the whole site to UK/US IP addresses only (see
# backend/middleware/geoRestrict.js for how it works and its limitations).
# Off by default so local development isn't accidentally blocked.
GEO_RESTRICT=false

